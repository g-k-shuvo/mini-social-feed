# Copy to .env and fill in. The process refuses to boot on a missing or
# malformed value rather than failing at the first request.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml. Port 5433 keeps out of the way of a local Postgres on 5432.
DATABASE_URL=postgresql://minisocial:minisocial@localhost:5433/minisocial?schema=public

# Migrations need an unpooled connection. Locally that is the same URL; on a
# serverless Postgres (Neon, Supabase) it is the "direct"/"non-pooling" string,
# because the pooler in front of DATABASE_URL cannot run DDL.
DIRECT_URL=postgresql://minisocial:minisocial@localhost:5433/minisocial?schema=public

# 32+ random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters

JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Base64 of the Firebase service-account JSON. NEVER commit the JSON itself.
#   node -e "console.log(Buffer.from(require('fs').readFileSync('service-account.json')).toString('base64'))"
# Leave empty in development: notifications are then logged instead of sent,
# and every other endpoint behaves normally.
FIREBASE_SERVICE_ACCOUNT_B64=

# Comma-separated allowlist. Expo dev server defaults to 8081.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

LOG_LEVEL=info
